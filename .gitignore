# Build artifacts
/bin/
/dist/
/out/
# A bare `go build` at the repo root drops the binary here (7.8 MB, Mach-O).
# /bin/freerag is the intended output; this one is an accident of `go build -o freerag`.
/freerag

# Local runtime data (SQLite + sqlite-vec, parsed cache)
/data/

# Downloaded models (see scripts/download-models.sh)
/models/
*.db
*.db-journal
*.db-wal
*.db-shm

# Toolchains installed locally for this repo
/.toolchain/

# Node / Electron
node_modules/
npm-debug.log*

# Python sidecar
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Generated reports (layout visualisation, etc.)
/artifacts/

# Local secrets (API keys). Never commit.
.env
.env.*
!.env.example

# Parse cache (regenerable)
/cache/

# Qdrant writes this marker into its working directory when started locally
.qdrant-initialized

# Vendored runtime for packaging: build-installer.sh fetches the Qdrant binary
# here so electron-builder has a stable path to bundle. Regenerable, and 73 MB.
/desktop/vendor/

# Evaluation venv (ragas pulls langchain/datasets; kept out of the sidecar runtime)
/.venv-ragas/

# Evaluation workspace: KBs, runs and the frozen split. NOT pushed (user's call,
# 2026-10-02). Nothing here is lost by that: `scripts/ragas_eval.py freeze` rebuilds
# the split deterministically from benchmarks/MultiHop-RAG, and the KB is rebuilt by
# the `index` stage.
/eval/
