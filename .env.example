# Template for local secrets. Copy to .env and fill in — .env is gitignored.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# The kernel reads real environment variables only; this file is a shell
# convenience, not something the binary parses.

# Embedding provider for dense retrieval. Empty/"none" leaves retrieval
# keyword-only (BM25 + grep), which is a valid degraded mode.
#   siliconflow  OpenAI-compatible hosted BGE-M3 (no model download)
#   local        reserved for a local BGE-M3 over ONNX/Ollama (docs/plan.md §4)
FREERAG_EMBED_PROVIDER=siliconflow

# Required when FREERAG_EMBED_PROVIDER=siliconflow.
FREERAG_SILICONFLOW_KEY=sk-replace-me

# Optional overrides.
FREERAG_EMBED_MODEL=BAAI/bge-m3
FREERAG_EMBED_DIMS=1024
FREERAG_SILICONFLOW_URL=https://api.siliconflow.cn/v1
